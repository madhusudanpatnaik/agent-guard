# Copy to .env and adjust. All variables are prefixed with AGENTGUARD_.

# Core
AGENTGUARD_ENVIRONMENT=development
AGENTGUARD_DATABASE_URL=sqlite:///./agentguard.db
# For Postgres:
# AGENTGUARD_DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/agentguard

# Security — CHANGE THESE for anything beyond local dev.
AGENTGUARD_SECRET_KEY=change-me-to-a-long-random-value
# Separate key for encrypting connector credentials; lets you rotate vault keys
# without re-keying the audit ledger. Falls back to SECRET_KEY if unset.
# AGENTGUARD_VAULT_KEY=
AGENTGUARD_BOOTSTRAP_ADMIN_EMAIL=admin@agentguard.local
AGENTGUARD_BOOTSTRAP_ADMIN_PASSWORD=admin

# Enterprise SSO (OpenID Connect) — set issuer + client_id to enable IdP login.
# AGENTGUARD_OIDC_ISSUER=https://login.microsoftonline.com/<tenant>/v2.0
# AGENTGUARD_OIDC_CLIENT_ID=
# AGENTGUARD_OIDC_CLIENT_SECRET=
# AGENTGUARD_OIDC_REDIRECT_URI=https://agentguard.corp/api/auth/oidc/callback
# AGENTGUARD_OIDC_DEFAULT_ROLE=viewer
# AGENTGUARD_OIDC_ALLOWED_DOMAIN=corp.example

# Governance
AGENTGUARD_DEFAULT_DENY=true
AGENTGUARD_DLP_BLOCK_EGRESS_ON_SECRET=true
# SSRF guard: block connector calls to private/loopback/metadata addresses.
# Unset = follow environment (off in dev, on in production). true/false to force.
# AGENTGUARD_BLOCK_PRIVATE_EGRESS=true

# Transparent proxy (agentguard proxy) — TLS-interception CA location + upstream
# verification. Install <dir>/agentguard-ca.crt in the agent's trust store.
AGENTGUARD_PROXY_CA_DIR=./agentguard-ca
AGENTGUARD_PROXY_VERIFY_UPSTREAM_TLS=true
AGENTGUARD_DEFAULT_AGENT_QUOTA=10000
AGENTGUARD_QUOTA_WINDOW_SECONDS=3600
AGENTGUARD_APPROVAL_TTL_SECONDS=3600
AGENTGUARD_MAX_REQUEST_SCAN_BYTES=262144

# Hardening
# Reject HTTP request bodies larger than this (bytes) with 413.
AGENTGUARD_MAX_REQUEST_BODY_BYTES=1048576
# Login brute-force protection: max failures per source IP per window (seconds).
AGENTGUARD_LOGIN_RATE_LIMIT_COUNT=5
AGENTGUARD_LOGIN_RATE_LIMIT_WINDOW=300
# Content-Security-Policy for the console (empty = secure built-in default).
# AGENTGUARD_CSP_POLICY=

# Integrity & observability
# Out-of-band ledger head anchor (detects head truncation). Empty disables.
AGENTGUARD_AUDIT_ANCHOR_PATH=./agentguard-ledger-anchor.log
# Optional SIEM sink — every decision is POSTed here as JSON (best-effort).
# AGENTGUARD_SIEM_WEBHOOK_URL=https://siem.example/ingest

# Detect & respond — risk alerts + notifications + automated containment.
# Alert webhook (Slack-formatted for hooks.slack.com URLs, else generic JSON).
# AGENTGUARD_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...
AGENTGUARD_ALERT_WEBHOOK_MIN_SEVERITY=medium
AGENTGUARD_ALERT_DENIAL_SPIKE_COUNT=5
AGENTGUARD_ALERT_DENIAL_SPIKE_WINDOW=60
# Auto-suspend an agent after N exfiltration attempts in the window (0 = off).
AGENTGUARD_AUTO_SUSPEND_ON_EXFIL_ATTEMPTS=0

# Adaptive risk scoring — a 0–100 score per decision from behavioral baselines
# (resource/action novelty, off-hours, volume z-score) + DLP + egress + amount.
AGENTGUARD_RISK_SCORING_ENABLED=true
# At/above this score an ALLOW is escalated to human approval (0 = off).
AGENTGUARD_RISK_STEP_UP_THRESHOLD=0
# At/above this score a high_risk alert is raised (0 = off).
AGENTGUARD_RISK_ALERT_THRESHOLD=0

# Scale — rate/quota counter backend. "db" (default) or "redis" (needs the
# [redis] extra + redis_url) for a sub-ms sliding window across gateway nodes.
AGENTGUARD_RATE_LIMIT_BACKEND=db
# AGENTGUARD_REDIS_URL=redis://localhost:6379/0

# Scale — circuit breaker / DLP detector cache / alert throttle backend.
# "memory" (default, correct for one worker) or "redis" (needs the [redis]
# extra + redis_url above) so every worker/replica shares breaker state, sees
# a new DLP detector immediately instead of per-worker, and dedups alerts
# fleet-wide. Falls back to in-process state on any Redis error.
AGENTGUARD_DISTRIBUTED_STATE_BACKEND=memory

# Guardrails — LLM-native security + optional ML DLP.
AGENTGUARD_LLM_GUARD_ENABLED=true
# AGENTGUARD_LLM_GUARD_WEBHOOK_URL=https://moderation.example/scan
# Extra DLP providers (needs the [dlp-ml] extra): comma-separated, e.g. presidio
# AGENTGUARD_DLP_PROVIDERS=presidio

# Policy-as-code — delegate the RBAC decision to OPA (Rego) or Cedar. Empty uses
# the built-in engine. AgentGuard still enforces DLP/quota/approvals/ledger.
# AGENTGUARD_POLICY_ENGINE=opa
# AGENTGUARD_POLICY_ENGINE_URL=http://localhost:8181/v1/data/agentguard/authz
AGENTGUARD_POLICY_ENGINE_FAIL_OPEN=false

# Distributed audit anchoring — any of: file, transparency_log, rfc3161.
AGENTGUARD_AUDIT_ANCHOR_BACKENDS=file
# AGENTGUARD_TRANSPARENCY_LOG_URL=https://rekor.example/api/v1/log/entries
# AGENTGUARD_RFC3161_TSA_URL=https://freetsa.org/tsr

# Observability — OpenTelemetry tracing (needs the [otel] extra).
AGENTGUARD_OTEL_ENABLED=false
AGENTGUARD_OTEL_SERVICE_NAME=agentguard
# AGENTGUARD_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Enterprise identity — SCIM 2.0 provisioning. Set the bearer token your IdP
# (Okta/Azure AD) presents; empty disables the /api/scim/v2 endpoints.
# AGENTGUARD_SCIM_BEARER_TOKEN=

# Server
AGENTGUARD_HOST=0.0.0.0
AGENTGUARD_PORT=8080
