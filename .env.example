# Copy to .env and adjust. All variables are prefixed with AGENTOPS_.

# Core
AGENTOPS_ENVIRONMENT=development
AGENTOPS_DATABASE_URL=sqlite:///./agentops.db
# For Postgres:
# AGENTOPS_DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/agentops

# Security — CHANGE THESE for anything beyond local dev.
AGENTOPS_SECRET_KEY=change-me-to-a-long-random-value
# Separate key for encrypting connector credentials; lets you rotate vault keys
# without re-keying the audit ledger. Falls back to SECRET_KEY if unset.
# AGENTOPS_VAULT_KEY=
AGENTOPS_BOOTSTRAP_ADMIN_EMAIL=admin@agentops.local
AGENTOPS_BOOTSTRAP_ADMIN_PASSWORD=admin

# Enterprise SSO (OpenID Connect) — set issuer + client_id to enable IdP login.
# AGENTOPS_OIDC_ISSUER=https://login.microsoftonline.com/<tenant>/v2.0
# AGENTOPS_OIDC_CLIENT_ID=
# AGENTOPS_OIDC_CLIENT_SECRET=
# AGENTOPS_OIDC_REDIRECT_URI=https://agentops.corp/api/auth/oidc/callback
# AGENTOPS_OIDC_DEFAULT_ROLE=viewer
# AGENTOPS_OIDC_ALLOWED_DOMAIN=corp.example

# Governance
AGENTOPS_DEFAULT_DENY=true
AGENTOPS_DLP_BLOCK_EGRESS_ON_SECRET=true
# SSRF guard: block connector calls to private/loopback/metadata addresses.
# Unset = follow environment (off in dev, on in production). true/false to force.
# AGENTOPS_BLOCK_PRIVATE_EGRESS=true

# Transparent proxy (agentops proxy) — TLS-interception CA location + upstream
# verification. Install <dir>/agentops-ca.crt in the agent's trust store.
AGENTOPS_PROXY_CA_DIR=./agentops-ca
AGENTOPS_PROXY_VERIFY_UPSTREAM_TLS=true
AGENTOPS_DEFAULT_AGENT_QUOTA=10000
AGENTOPS_QUOTA_WINDOW_SECONDS=3600
AGENTOPS_APPROVAL_TTL_SECONDS=3600
AGENTOPS_MAX_REQUEST_SCAN_BYTES=262144

# Hardening
# Reject HTTP request bodies larger than this (bytes) with 413.
AGENTOPS_MAX_REQUEST_BODY_BYTES=1048576
# Login brute-force protection: max failures per source IP per window (seconds).
AGENTOPS_LOGIN_RATE_LIMIT_COUNT=5
AGENTOPS_LOGIN_RATE_LIMIT_WINDOW=300
# Content-Security-Policy for the console (empty = secure built-in default).
# AGENTOPS_CSP_POLICY=

# Integrity & observability
# Out-of-band ledger head anchor (detects head truncation). Empty disables.
AGENTOPS_AUDIT_ANCHOR_PATH=./agentops-ledger-anchor.log
# Optional SIEM sink — every decision is POSTed here as JSON (best-effort).
# AGENTOPS_SIEM_WEBHOOK_URL=https://siem.example/ingest

# Detect & respond — risk alerts + notifications + automated containment.
# Alert webhook (Slack-formatted for hooks.slack.com URLs, else generic JSON).
# AGENTOPS_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...
AGENTOPS_ALERT_WEBHOOK_MIN_SEVERITY=medium
AGENTOPS_ALERT_DENIAL_SPIKE_COUNT=5
AGENTOPS_ALERT_DENIAL_SPIKE_WINDOW=60
# Auto-suspend an agent after N exfiltration attempts in the window (0 = off).
AGENTOPS_AUTO_SUSPEND_ON_EXFIL_ATTEMPTS=0

# Adaptive risk scoring — a 0–100 score per decision from behavioral baselines
# (resource/action novelty, off-hours, volume z-score) + DLP + egress + amount.
AGENTOPS_RISK_SCORING_ENABLED=true
# At/above this score an ALLOW is escalated to human approval (0 = off).
AGENTOPS_RISK_STEP_UP_THRESHOLD=0
# At/above this score a high_risk alert is raised (0 = off).
AGENTOPS_RISK_ALERT_THRESHOLD=0

# Scale — rate/quota counter backend. "db" (default) or "redis" (needs the
# [redis] extra + redis_url) for a sub-ms sliding window across gateway nodes.
AGENTOPS_RATE_LIMIT_BACKEND=db
# AGENTOPS_REDIS_URL=redis://localhost:6379/0

# Guardrails — LLM-native security + optional ML DLP.
AGENTOPS_LLM_GUARD_ENABLED=true
# AGENTOPS_LLM_GUARD_WEBHOOK_URL=https://moderation.example/scan
# Extra DLP providers (needs the [dlp-ml] extra): comma-separated, e.g. presidio
# AGENTOPS_DLP_PROVIDERS=presidio

# Policy-as-code — delegate the RBAC decision to OPA (Rego) or Cedar. Empty uses
# the built-in engine. AgentOps still enforces DLP/quota/approvals/ledger.
# AGENTOPS_POLICY_ENGINE=opa
# AGENTOPS_POLICY_ENGINE_URL=http://localhost:8181/v1/data/agentops/authz
AGENTOPS_POLICY_ENGINE_FAIL_OPEN=false

# Distributed audit anchoring — any of: file, transparency_log, rfc3161.
AGENTOPS_AUDIT_ANCHOR_BACKENDS=file
# AGENTOPS_TRANSPARENCY_LOG_URL=https://rekor.example/api/v1/log/entries
# AGENTOPS_RFC3161_TSA_URL=https://freetsa.org/tsr

# Observability — OpenTelemetry tracing (needs the [otel] extra).
AGENTOPS_OTEL_ENABLED=false
AGENTOPS_OTEL_SERVICE_NAME=agentops
# AGENTOPS_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Enterprise identity — SCIM 2.0 provisioning. Set the bearer token your IdP
# (Okta/Azure AD) presents; empty disables the /api/scim/v2 endpoints.
# AGENTOPS_SCIM_BEARER_TOKEN=

# Server
AGENTOPS_HOST=0.0.0.0
AGENTOPS_PORT=8080
